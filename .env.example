# Setting names only; never commit values. The full onboarding settings list is
# in docs/operations/client-onboarding.md (Configuration).

# Optional: reply-to/requester address SignWell shows on onboarding packets
# (one email address; omitted from SignWell when unset).
ONBOARDING_REQUESTER_EMAIL=

# Optional: minutes (0-60, default 60) before SignWell emails the Iron Wing
# signer when the owner has not signed in Outreach (embedded signing, R14).
ONBOARDING_IRON_WING_EMAIL_DELAY_MINUTES=

# Carrier onboarding portal
ONBOARDING_PORTAL_ENABLED=
ONBOARDING_PORTAL_BASE_URL=
ONBOARDING_PORTAL_TOKEN_SECRET=
ONBOARDING_R2_ACCOUNT_ID=
ONBOARDING_R2_BUCKET=
ONBOARDING_R2_ACCESS_KEY_ID=
ONBOARDING_R2_SECRET_ACCESS_KEY=
ONBOARDING_FILE_ENCRYPTION_KEY=
ONBOARDING_DOC_READER_ENABLED=
ONBOARDING_DOC_READER_MODEL=
ANTHROPIC_API_KEY=
