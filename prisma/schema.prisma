// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma
// WARNING: This schema is the single source of truth for the entire server

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------------------
// User
// -------------------------------------------------------------------------
model user {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       String   @default("user") // "admin", "dispatcher", "driver"
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  driver     driver?
  dispatcher dispatcher?
  company_id Int?
  company    company?    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  SignUpForm SignUpForm?

  @@index([company_id]) // Correct way to index company_id
}

// ---------------------------------------------------------------------------
// Drivers
// ------------------------------------------------------------------------
model driver {
  id         Int      @id @default(autoincrement())
  user_id    Int?     @unique
  first_name String
  last_name  String
  company_id Int?
  truck_id   Int?
  trailer_id Int?
  created_at DateTime @default(now())

  user    user?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company company? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  truck   truck?   @relation(fields: [truck_id], references: [id])
  trailer trailer? @relation(fields: [trailer_id], references: [id])

  call_logs    call_log[]
  message_logs message_log[]

  // Many-to-Many with dispatchers
  assigned_dispatchers dispatcher_driver[]

  @@index([company_id])
  @@index([user_id])
}

// ---------------------------------------------------------------------------
// Dispatchers
// ---------------------------------------------------------------------------
model dispatcher {
  id         Int      @id @default(autoincrement())
  user_id    Int?     @unique
  first_name String
  last_name  String
  created_at DateTime @default(now())

  // Link to users
  user user? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Many-to-Many with drivers
  assigned_drivers dispatcher_driver[]
  company          company?            @relation(fields: [companyId], references: [id])
  companyId        Int?
}

model dispatcher_driver {
  dispatcher_id Int
  driver_id     Int

  dispatcher dispatcher @relation(fields: [dispatcher_id], references: [id], onDelete: Cascade)
  driver     driver     @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@unique([dispatcher_id, driver_id])
}

// ---------------------------------------------------------------------------
// Companies
// ---------------------------------------------------------------------------
model company {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  phone      String?
  email      String?
  website    String?
  mc_number  String?
  dot_number String?
  ein_number String?

  // Numeric fields for how many drivers/trucks/trailers a company has
  drivers_total  Int? @default(0)
  trucks_total   Int? @default(0)
  trailers_total Int? @default(0)

  // Relations
  users        user[]
  dispatchers  dispatcher[]
  drivers      driver[]
  trucks       truck[]
  trailers     trailer[]
  call_logs    call_log[]    @relation("CompanyCallLogs")
  message_logs message_log[] @relation("CompanyMessages")
  SignUpForm   SignUpForm[]
}

// ---------------------------------------------------------------------------
// Trucks
// ---------------------------------------------------------------------------
model truck {
  id           Int    @id @default(autoincrement())
  model        String
  make         String
  trailer_type String
  plate_number String

  // Link truck to a company
  company_id Int?
  company    company? @relation(fields: [company_id], references: [id])

  // If multiple drivers can share a single truck
  drivers driver[]

  @@index([company_id])
}

// ---------------------------------------------------------------------------
// Trailers
// ---------------------------------------------------------------------------
model trailer {
  id           Int    @id @default(autoincrement())
  type         String
  model        String
  make         String
  trailer_type String
  plate_number String

  // Link trailer to a company
  company_id Int?
  company    company? @relation(fields: [company_id], references: [id])

  // If multiple drivers can share a single trailer
  drivers driver[]

  @@index([company_id])
}

// ---------------------------------------------------------------------------
// iron-wing-dispatching.com
// ---------------------------------------------------------------------------
model SignUpForm {
  id           Int      @id @default(autoincrement())
  first_name   String
  last_name    String
  email        String
  phone        String
  fleet_size   String
  trailer_type String
  plan         String
  submit_date  DateTime @default(now())
  status       String   @default("pending") // "pending", "reviewed", "approved", "rejected"

  // New relations to track approved sign-ups
  user_id    Int?     @unique
  user       user?    @relation(fields: [user_id], references: [id])
  company_id Int?
  company    company? @relation(fields: [company_id], references: [id])

  // Lead attribution
  outreach_ref        String?
  posthog_distinct_id String?

  @@index([company_id])
  @@index([user_id])
  @@map("sign_up_form")
}

model ContactSubmission {
  id          Int      @id @default(autoincrement())
  email       String
  phone       String?
  message     String
  submit_date DateTime @default(now())

  // Lead attribution
  outreach_ref        String?
  posthog_distinct_id String?

  @@map("contact_submission")
}

model NewsletterSubscriber {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  source          String    @default("website")
  subscribed_at   DateTime  @default(now())
  unsubscribed_at DateTime?

  // Lead attribution
  outreach_ref        String?
  posthog_distinct_id String?

  @@map("newsletter_subscriber")
}

// ---------------------------------------------------------------------------
// Twilio-voip
// ---------------------------------------------------------------------------
model call_log {
  id          Int      @id @default(autoincrement())
  call_sid    String   @unique
  timestamp   DateTime @default(now())
  from_number String
  to_number   String
  status      String?
  duration    Int?     @default(0)
  direction   String?  @default("unknown")

  // Relation to drivers
  driver_id Int?
  driver    driver? @relation(fields: [driver_id], references: [id])

  // Relation to company through driver
  company_id Int?
  company    company? @relation("CompanyCallLogs", fields: [company_id], references: [id])

  @@map("call_logs")
}

model message_log {
  id          Int      @id @default(autoincrement())
  message_sid String   @unique
  from_number String
  to_number   String
  body        String
  timestamp   DateTime @default(now())

  // Relation to drivers
  driver_id Int?
  driver    driver? @relation(fields: [driver_id], references: [id])

  // Relation to company through drivers
  company_id Int?
  company    company? @relation("CompanyMessages", fields: [company_id], references: [id])

  @@map("message_logs")
}

// ===========================================================================
// TEMPORARY: interim billing models. Delete with the feature, in a migration
// that drops the interim_billing_* tables. See src/interimBilling/DISPOSE.md.
// ===========================================================================
model InterimBillingCarrier {
  id                 Int      @id @default(autoincrement())
  legal_name         String
  mc                 String?
  usdot              String?
  email              String
  plan_label         String?
  fee_bp             Int
  stripe_customer_id String?  @unique
  primary_pm_id      String?
  primary_pm_brand   String?
  primary_pm_last4   String?
  backup_pm_id       String?
  backup_pm_brand    String?
  backup_pm_last4    String?
  status             String   @default("active")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  assets   InterimBillingCarrierAsset[]
  lines    InterimBillingLine[]
  invoices InterimBillingInvoice[]

  @@map("interim_billing_carrier")
}

model InterimBillingCarrierAsset {
  id             Int      @id @default(autoincrement())
  carrier_id     Int
  kind           String // "DRIVER" or "TRUCK"
  kelevo_id      Int
  effective_from DateTime @default(now())

  carrier InterimBillingCarrier @relation(fields: [carrier_id], references: [id], onDelete: Cascade)

  @@unique([kind, kelevo_id])
  @@index([carrier_id])
  @@map("interim_billing_carrier_asset")
}

model InterimBillingRun {
  id                     Int       @id @default(autoincrement())
  run_end                DateTime  @unique
  status                 String    @default("building") // building, awaiting_approval, approved, charging, done
  approved_by            String?
  approved_at            DateTime?
  approved_invoice_count Int?
  approved_total_cents   Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  lines    InterimBillingLine[]
  invoices InterimBillingInvoice[]

  @@map("interim_billing_run")
}

model InterimBillingLine {
  id                     Int      @id @default(autoincrement())
  run_id                 Int
  kelevo_load_id         Int
  load_number            Int?
  kind                   String // "DELIVERED" or "CARRIER_CANCELLED"
  carrier_id             Int?
  all_in_rate_cents      Int?
  linehaul_cents         Int?
  linehaul_note          String?
  fee_bp                 Int?
  fee_cents              Int?
  hold_reason            String?
  status                 String // held, ready, invoiced, paid, failed, skipped
  occurred_at            DateTime
  invoice_id             Int?
  stripe_invoice_item_id String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  run     InterimBillingRun      @relation(fields: [run_id], references: [id])
  carrier InterimBillingCarrier? @relation(fields: [carrier_id], references: [id])
  invoice InterimBillingInvoice? @relation(fields: [invoice_id], references: [id])

  @@unique([kelevo_load_id, kind])
  @@index([status])
  @@index([run_id])
  @@index([invoice_id])
  @@map("interim_billing_line")
}

model InterimBillingInvoice {
  id                      Int       @id @default(autoincrement())
  run_id                  Int
  carrier_id              Int
  stripe_invoice_id       String?   @unique
  total_cents             Int
  status                  String    @default("draft") // draft, finalizing, processing, paid, retry_scheduled, failed
  attempts                Int       @default(0)
  round                   Int       @default(0)
  tried_backup_this_round Boolean   @default(false)
  first_failure_at        DateTime?
  next_attempt_at         DateTime?
  next_method             String? // "primary" or "backup"
  current_pm_id           String?
  payment_intent_id       String?
  last_error_code         String?
  hosted_invoice_url      String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  run     InterimBillingRun     @relation(fields: [run_id], references: [id])
  carrier InterimBillingCarrier @relation(fields: [carrier_id], references: [id])
  lines   InterimBillingLine[]

  @@unique([run_id, carrier_id])
  @@index([status, next_attempt_at])
  @@map("interim_billing_invoice")
}

model InterimBillingStripeEvent {
  id          String   @id // the Stripe event id
  type        String
  received_at DateTime @default(now())

  @@map("interim_billing_stripe_event")
}

// ===========================================================================
// Client onboarding (permanent). Owned by src/clients, src/onboarding and
// src/payments. Never imported by or from interim billing code paths except
// interim billing reading a Client through src/clients. Design §7–§8 of the
// 2026-11-18 workflow modernization design.
// ===========================================================================
model Client {
  id                  String   @id @default(uuid())
  legal_name          String
  dba_name            String?
  mc_number           String?
  usdot               String?  @unique
  primary_email       String
  status              String   @default("ONBOARDING") // ONBOARDING | ACTIVE | INACTIVE
  stripe_customer_id  String?  @unique
  payment_method_id   String?
  payment_method_type String?
  payment_last4       String?
  payment_brand       String?
  outreach_party_id   String?
  kelevo_ref          String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  requests OnboardingRequest[]

  @@map("client")
}

model OnboardingRequest {
  id                    String    @id @default(uuid())
  idempotency_key       String    @unique
  source                String
  source_refs           Json
  actor                 Json
  terms                 Json // immutable (database trigger)
  terms_hash            String
  confirmed_at          DateTime
  client_id             String
  bundle_version_id     String?
  signature_state       String    @default("NOT_SENT")
  signature_code        String?
  signature_at          DateTime?
  signature_waiting_for String? // IRON_WING | CARRIER while SENT/VIEWED (R14)
  payment_state         String    @default("NOT_STARTED")
  payment_code          String?
  payment_method_type   String?
  payment_last4         String?
  payment_at            DateTime?
  provisioning_state    String    @default("NOT_STARTED")
  provisioning_code     String?
  kelevo_ref            String?
  provisioning_at       DateTime?
  operations            Json
  version               Int       @default(1)
  cancelled_at          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  client    Client              @relation(fields: [client_id], references: [id])
  envelopes SignatureEnvelope[]
  payments  PaymentSetup[]
  events    OnboardingEvent[]
  accesses  DocumentAccessLog[]

  @@index([client_id])
  @@index([signature_state])
  @@index([payment_state])
  @@map("onboarding_request")
}

model DocumentBundleVersion {
  id          String    @id @default(uuid())
  name        String
  version     Int
  files       Json // [{ name, sha256, size, storage_key }]
  layout      Json
  status      String    @default("DRAFT") // DRAFT | APPROVED | RETIRED
  approved_by String?
  approved_at DateTime?
  created_at  DateTime  @default(now())

  @@unique([name, version])
  @@map("document_bundle_version")
}

model SignatureEnvelope {
  id                    String    @id @default(uuid())
  request_id            String
  provider              String
  provider_document_id  String?   @unique
  state                 String    @default("SENDING")
  last_error_code       String?
  filled_sha256         String?
  filled_storage_key    String?
  completed_sha256      String?
  completed_storage_key String?
  sent_at               DateTime?
  completed_at          DateTime?
  declined_at           DateTime?
  expired_at            DateTime?
  superseded_by         String?
  last_webhook_fetch_at DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  request OnboardingRequest @relation(fields: [request_id], references: [id])

  @@index([request_id])
  @@index([state])
  @@map("signature_envelope")
}

model PaymentSetup {
  id                  String    @id @default(uuid())
  request_id          String
  checkout_session_id String?   @unique
  checkout_url        String?
  expires_at          DateTime?
  setup_intent_id     String?
  state               String    @default("CREATING") // CREATING | OPEN | PENDING_VERIFICATION | SUCCEEDED | FAILED | EXPIRED | SUPERSEDED
  last_error_code     String?
  payment_method_id   String?
  method_type         String?
  last4               String?
  brand               String?
  emailed_at          DateTime?
  completed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  request OnboardingRequest @relation(fields: [request_id], references: [id])

  @@index([request_id])
  @@index([state])
  @@map("payment_setup")
}

model OnboardingEvent {
  id              String    @id @default(uuid())
  event_id        String    @unique
  request_id      String
  type            String
  version         Int
  payload         Json
  delivered_at    DateTime?
  attempts        Int       @default(0)
  next_attempt_at DateTime?
  last_error_code String?
  created_at      DateTime  @default(now())

  request OnboardingRequest @relation(fields: [request_id], references: [id])

  @@index([request_id, version])
  @@index([type, delivered_at, next_attempt_at])
  @@map("onboarding_event")
}

model ProviderWebhookReceipt {
  id          String   @id @default(uuid())
  provider    String
  receipt_key String   @unique
  received_at DateTime @default(now())

  @@map("provider_webhook_receipt")
}

model DocumentAccessLog {
  id         String   @id @default(uuid())
  request_id String
  actor      Json
  document   String
  at         DateTime @default(now())

  request OnboardingRequest @relation(fields: [request_id], references: [id])

  @@index([request_id])
  @@map("document_access_log")
}
